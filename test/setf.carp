(load "../Setf.carp")

(deftype T [x Int y Int z Int])
(derive T =)
(derive T str)

(Setf.register-simple-place 'T.x 'T.set-x!)

(deftype V [x Int y Int])
(derive V =)
(derive V str)
(Setf.register-struct-places 'V)

(Setf.register-place 'aset-place (fn [args] (cons 'Array.aset! args)))

(load "Test.carp")
(use-all Test Setf)

; a macro error aborts the compiler, so this path needs a child run
(shell "{ carp -x test/non-symbol-place.carp 2>&1 | grep -q 'can only update a symbol' && printf caught || printf missed ; } > /tmp/setf-non-symbol-place.txt")
(defdynamic non-symbol-place (read-file "/tmp/setf-non-symbol-place.txt"))

(deftest test
  (assert-dynamic-equal test
                        '(1 2 3)
                        (let-do [x '(2 2 3)]
                          (setf (car x) 1)
                          x)
                        "setf works for car"
  )
  (assert-dynamic-equal test
                        '(1 2)
                        (let-do [x '(1 2 3)]
                          (setf (cdr x) '(2))
                          x)
                        "setf works for cdr"
  )
  (assert-dynamic-equal test
                        "caught"
                        non-symbol-place
                        "setf rejects a car place that is not a symbol"
  )
  (assert-equal test
                &[1 2 3]
                &(let-do [x [1 3 3]]
                  (setf (nth &x 1) 2)
                  x)
                "setf works for nth"
  )
  (assert-equal test
                "hey"
                &(let-do [x @"hoy"]
                  (setf (char-at &x 1) \e)
                  x)
                "setf works for char-at"
  )
  (assert-equal test
                10
                (let-do [x 1]
                  (setf x 10)
                  x)
                "setf works on symbols"
  )
  (assert-equal test
                &(T.init 1 1 1)
                &(let-do [x (T.init 0 1 1)]
                  (setf (T.x &x) 1)
                  x)
                "setf works on custom types"
  )
  (assert-equal test
                &(V.init 10 20)
                &(let-do [v (V.init 1 2)]
                  (setf (V.x &v) 10)
                  (setf (V.y &v) 20)
                  v)
                "register-struct-places generates working places"
  )
  (assert-equal test
                &[1 9 3]
                &(let-do [x [1 2 3]]
                  (setf (aset-place &x 1) 9)
                  x)
                "register-place works with a custom builder"
  )
)
